# Tracker URL for development (local Flask app)
TRACKER_URL_DEVELOPMENT=http://localhost:5000

# Tracker URL for staging (deploy to staging server)
TRACKER_URL_STAGING=http://localhost:5000

# Tracker URL for production (deployed to Render/Heroku)
# Examples:
# https://ken-email-tracker.onrender.com
# https://ken-email-tracker.herokuapp.com
TRACKER_URL_PRODUCTION=https://ken-email-tracker.onrender.com

# Set to: development, staging, or production
ENV=development

# Flask Debug Mode (development only)
FLASK_DEBUG=False

# Flask Port (default: 5000)
PORT=5000
